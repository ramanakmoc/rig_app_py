# Copy to .env and fill in. Do NOT commit the real .env.
#   cp .env.example .env && chmod 600 .env

# ── Django ───────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=db.krissdrilling.com,www.db.krissdrilling.com,localhost,127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────────────────
DB_NAME=rig_operations_py
DB_USER=rig_user_py
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ── Outbound email (notifications, acknowledgements, daily report) ────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=reportskrissdrilling@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KRISS DRILLING Reports <reportskrissdrilling@gmail.com>
REPORT_RECIPIENTS=it.admin@krissdrilling.com,head-operations@krissdrilling.com
EMAIL_COLLECTION_ALERT_RECIPIENTS=it.admin@krissdrilling.com,head-operations@krissdrilling.com

# ── Mailbox credential encryption (REQUIRED when DEBUG=False) ─────────────
# Generate: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Must be different from DJANGO_SECRET_KEY.
EMAIL_COLLECTION_FERNET_KEY=

# ── Collection safeguards ────────────────────────────────────────────────
EMAIL_COLLECTION_MAX_ATTACHMENT_BYTES=26214400
EMAIL_COLLECTION_MAX_ZIP_MEMBERS=50
EMAIL_COLLECTION_MAX_ZIP_UNCOMPRESSED_BYTES=104857600
EMAIL_COLLECTION_REVIEW_THRESHOLD=0.65
EMAIL_COLLECTION_MAX_ATTEMPTS=3

# ── AI / LLM extraction (Claude Opus 4.8) ────────────────────────────────
# Leave EMAIL_REPORTS_AI_EXTRACTOR blank to use rules-only classification.
EMAIL_REPORTS_AI_EXTRACTOR=email_reports.services.ai_extractor.extract
EMAIL_REPORTS_AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
